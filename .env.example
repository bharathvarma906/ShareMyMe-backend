# Environment Mode
NODE_ENV=production

# MongoDB Atlas Connection String
# Get this from your MongoDB Atlas Dashboard -> Connect -> Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sharemymeal?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=30d

# Allowed Frontend Origins (Optional - comma-separated list of URLs, or * to allow any)
ALLOWED_ORIGINS=*

# NOTE: PORT is NOT required here. Render injects it automatically.
